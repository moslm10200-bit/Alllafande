// Firebase Console → Firestore Database → Rules (الصق وانشر)
// بدّل البريد بإيميل حساب الأدمن الذي أنشأته في Authentication
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "ADMIN@EMAIL.COM";
    }
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /orders/{id}   { allow create: if true; allow read, update, delete: if isAdmin(); }
  }
}
